# Tableau MCP Server Config
TRANSPORT='stdio'
AUTH='pat'
# Active profile: cloud | onprem
DEFAULT_TABLEAU_SITE_PROFILE='cloud'

# Profile: Tableau Cloud
TABLEAU_SITE_CLOUD_LABEL='Tableau Cloud'
TABLEAU_SITE_CLOUD_SERVER='https://10ax.online.tableau.com'
TABLEAU_SITE_CLOUD_SITE_NAME='your-site'
TABLEAU_SITE_CLOUD_PAT_NAME='PAT name'
TABLEAU_SITE_CLOUD_PAT_VALUE='PAT secret'

# Profile: Tableau Server (on-prem / internal). Empty SITE_NAME = Default site.
TABLEAU_SITE_ONPREM_LABEL='Tableau Server'
TABLEAU_SITE_ONPREM_SERVER='http://your-tableau-server.internal'
TABLEAU_SITE_ONPREM_SITE_NAME=''
TABLEAU_SITE_ONPREM_PAT_NAME='PAT name'
TABLEAU_SITE_ONPREM_PAT_VALUE='PAT secret'

# Legacy keys (synced from active profile)
SERVER='https://10ax.online.tableau.com'
SITE_NAME='your-site'
PAT_NAME='PAT name'
PAT_VALUE='PAT secret'

# Tableau MCP Server Optional Configs
DATASOURCE_CREDENTIALS=''
DEFAULT_LOG_LEVEL='debug'
INCLUDE_TOOLS=''
EXCLUDE_TOOLS=''
MAX_RESULT_LIMIT=''
DISABLE_QUERY_DATASOURCE_FILTER_VALIDATION=''

# Local Filepath Config
TABLEAU_MCP_FILEPATH='your/local/filepath/to/tableau-mcp/build/index.js'

# Model Providers
OPENAI_API_KEY='from OpenAI developer portal'
OPENAI_MODEL='gpt-5.4-mini'
LLM_PROVIDER='OpenAI'

# Optional OpenAI-compatible gateway profile (e.g. AWS API Gateway → Bedrock)
LLM_GATEWAY_URL='https://your-api.execute-api.region.amazonaws.com/v1'
LLM_GATEWAY_API_KEY='gateway bearer api key'
LLM_GATEWAY_MODEL='us.meta.llama3-1-8b-instruct-v1:0'
LLM_GATEWAY_PROVIDER='AWS Bedrock'
DEFAULT_LLM_PROFILE='openai'

# Langfuse 
LANGFUSE_PUBLIC_KEY = 'Public key from https://langfuse.com/'
LANGFUSE_SECRET_KEY = 'Secret key from https://langfuse.com/'
LANGFUSE_HOST = 'https://cloud.langfuse.com'

# Custom MCP Tool Extra Configs
# from: https://github.com/wjsutton/tableau-mcp-experimental
FIXED_DATASOURCE_LUID='unique identifier for a data source found via the graphql metadata API'
